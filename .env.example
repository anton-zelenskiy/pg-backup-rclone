# PostgreSQL connection
DB_HOST=db
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# Or use PG* aliases
# PGHOST=db
# PGPORT=5432
# PGUSER=your_db_user
# PGPASSWORD=your_db_password
# PGDATABASE=your_db_name

BACKUP_ALL_DATABASES=false

# Schedule (supercronic / cron syntax)
BACKUP_CRON=0 3 * * 0
SCHEDULE_ENABLED=true
RUN_ONCE=false
BACKUP_ON_START=false

# Storage
BACKUP_DIR=/backups
BACKUP_KEEP_DAYS=7

# Google Drive via rclone
UPLOAD_ENABLED=true
RCLONE_CONFIG=/config/rclone/rclone.conf
RCLONE_REMOTE=gdrive
RCLONE_PATH=backups/your_backup_folder
RCLONE_KEEP_DAYS=30
# Optional: Google Shared drive folder ID (from Drive URL)
# RCLONE_DRIVE_ROOT_FOLDER_ID=
